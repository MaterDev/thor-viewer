{
  "name": "thor-viewer",
  "version": "1.1.0",
  "description": "Full-screen live view of Claude's browser on the AYN Thor",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --import /home/key/.local/share/playwright-mcp/platform-linux.mjs test/smoke.mjs",
    "build:icons": "node tools/build-icons.mjs",
    "test:live": "node --test test/modes.test.mjs test/heat.test.mjs && bash test/gate.test.sh && node test/live.mjs",
    "test:tabs": "node --import /home/key/.local/share/playwright-mcp/platform-linux.mjs test/tabs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaterDev/thor-viewer.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "bugs": {
    "url": "https://github.com/MaterDev/thor-viewer/issues"
  },
  "homepage": "https://github.com/MaterDev/thor-viewer#readme",
  "devDependencies": {
    "@carbon/icons": "11.88.0"
  },
  "private": true
}
